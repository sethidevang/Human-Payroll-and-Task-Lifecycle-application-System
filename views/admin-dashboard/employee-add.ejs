<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com?plugins=forms,typography"></script>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <title>Add Employee | HR Suite</title>
    <style>
        html, body {
            height: 100%;
            margin: 0;
            font-family: 'Inter', sans-serif;
        }
        .container {
            min-height: 100vh;
            display: flex;
        }
        .form-container {
            background-color: #ffffff;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
        }
        .input-field {
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            transition: all 0.2s;
        }
        .input-field:focus {
            background-color: #ffffff;
            border-color: #6366f1;
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
        }
        .button-primary {
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
            color: #ffffff;
            border-radius: 8px;
            padding: 12px 24px;
            font-weight: 600;
            transition: all 0.3s;
        }
        .button-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
        }
    </style>
</head>
<body class="bg-gray-50">
    <div class="container">
        <!-- Sidebar -->
        <%- include('../admin-left-bar') %>

        <!-- Main Content -->
        <div class="flex-1 p-8 overflow-y-auto">
            <div class="max-w-4xl mx-auto">
                <div class="form-container p-8">
                    <div class="flex items-center gap-3 mb-8">
                        <span class="material-symbols-outlined text-indigo-600 text-3xl">person_add</span>
                        <h2 class="text-2xl font-bold text-gray-800">Add New Employee</h2>
                    </div>

                    <form id="employeeAddForm" class="grid grid-cols-1 md:grid-cols-2 gap-6" enctype="multipart/form-data">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">First Name</label>
                            <input type="text" id="firstName" name="firstName" placeholder="John" required class="w-full px-4 py-2.5 rounded-lg input-field focus:outline-none">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Last Name</label>
                            <input type="text" id="lastName" name="lastName" placeholder="Doe" required class="w-full px-4 py-2.5 rounded-lg input-field focus:outline-none">
                        </div>
                        <div class="md:col-span-2">
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Address</label>
                            <input type="text" id="address" name="address" placeholder="123 Corporate Way, Suite 100" required class="w-full px-4 py-2.5 rounded-lg input-field focus:outline-none">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Email Address</label>
                            <input type="email" id="email" name="email" placeholder="john.doe@company.com" required class="w-full px-4 py-2.5 rounded-lg input-field focus:outline-none">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Age</label>
                            <input type="number" id="age" name="age" min="18" max="70" placeholder="25" required class="w-full px-4 py-2.5 rounded-lg input-field focus:outline-none">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Basic Salary (₹)</label>
                            <input type="number" id="salary" name="salary" placeholder="50000" required class="w-full px-4 py-2.5 rounded-lg input-field focus:outline-none">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Designation</label>
                            <input type="text" id="designation" name="designation" placeholder="Software Engineer" required class="w-full px-4 py-2.5 rounded-lg input-field focus:outline-none">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Passport Number</label>
                            <input type="text" id="passportNumber" name="passportNumber" placeholder="L1234567" required class="w-full px-4 py-2.5 rounded-lg input-field focus:outline-none">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Nominee Name</label>
                            <input type="text" id="nominee" name="nominee" placeholder="Jane Doe" required class="w-full px-4 py-2.5 rounded-lg input-field focus:outline-none">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Employee User ID (Numeric)</label>
                            <input type="number" id="userId" name="userId" placeholder="1001" required class="w-full px-4 py-2.5 rounded-lg input-field focus:outline-none">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Login Password</label>
                            <input type="password" id="password" name="password" placeholder="••••••••" required class="w-full px-4 py-2.5 rounded-lg input-field focus:outline-none">
                        </div>
                        <div class="md:col-span-2">
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Profile Photo</label>
                            <div class="flex items-center justify-center w-full">
                                <label class="flex flex-col items-center justify-center w-full h-32 border-2 border-dashed border-gray-300 rounded-lg cursor-pointer bg-gray-50 hover:bg-gray-100 transition-colors">
                                    <div class="flex flex-col items-center justify-center pt-5 pb-6">
                                        <span class="material-symbols-outlined text-gray-400 text-3xl mb-2">cloud_upload</span>
                                        <p class="text-sm text-gray-500">Click to upload or drag and drop</p>
                                    </div>
                                    <input type="file" id="photo-upload" name="photo-upload" accept="image/*" class="hidden" />
                                </label>
                            </div>
                        </div>
                        
                        <div class="md:col-span-2 flex justify-end mt-4">
                            <button type="submit" class="button-primary flex items-center gap-2">
                                <span class="material-symbols-outlined text-sm">person_add</span>
                                Create Employee Account
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.getElementById('employeeAddForm').addEventListener('submit', async function(event) {
            event.preventDefault();

            // Show Loading State
            Swal.fire({
                title: 'Creating Account...',
                text: 'Please wait while we save the details.',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            const formData = new FormData(this);
            
            try {
                const response = await fetch('/admin/add-employee', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();

                if (response.ok) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Success!',
                        text: 'Employee account created successfully.',
                        confirmButtonColor: '#6366f1'
                    });
                    this.reset();
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Oops...',
                        text: result.error || 'Something went wrong. Please check your data.',
                        confirmButtonColor: '#6366f1'
                    });
                }
            } catch (error) {
                console.error("Error:", error);
                Swal.fire({
                    icon: 'error',
                    title: 'Network Error',
                    text: 'Could not connect to the server. Please try again.',
                    confirmButtonColor: '#6366f1'
                });
            }
        });
    </script>
</body>
</html>
<%- include('../footer') %>