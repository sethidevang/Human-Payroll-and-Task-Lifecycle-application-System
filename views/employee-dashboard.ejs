<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Employee Dashboard</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
        integrity="sha512-p2SRgsDW1JbF2GsvHDv5z5fCrDsfX+xJeR02LfZwP4KjbJ4CpZ5p1azSfzM11tEJv54pN6p6LEIoMRkgSpXahQ=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .widget {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            height: 200px;
        }

        .mark-as-done.active {
            background-color: #48bb78;
        }
    </style>
</head>

<body class="m-0 p-0 font-sans bg-gray-100 flex h-screen">
    <div class="flex w-full">

        <!-- Leftbar -->
        <%- include('employee/left-bar') %>

            <!-- Main Content -->
            <main class="flex-1 p-5 space-y-5 overflow-y-auto">
                <!-- Dashboard Widgets -->
                <section class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
                    <!-- Task Status Widget -->
                    <div class="bg-white p-5 rounded-lg shadow-lg widget">
                        <div>
                            <h3 class="text-lg font-bold">Task Status</h3>
                            <p>Pending Tasks: <%= tasksPendingCount %></p>
                            <p>Completed Tasks: <%= tasksCompletedCount %></p>
                        </div>
                        <a href="/employee-dashboard/task">
                            <button class="bg-indigo-600 text-white px-4 py-2 rounded-lg mt-auto">
                                View Tasks
                            </button>
                        </a>
                    </div>

                    <!-- Attendance Status Widget -->
                    <div class="bg-white p-5 rounded-lg shadow-lg widget">
                        <div>
                            <h3 class="text-lg font-bold">Attendance Status</h3>
                            <p>Present Days: <%= presentDays %></p>
                            <p>Leave Days: <%= leaveDays %></p>
                        </div>
                        <a href="/employee-dashboard/attendance">
                            <button class="bg-indigo-600 text-white px-4 py-2 rounded-lg mt-auto">
                                Attendance
                            </button>
                        </a>
                    </div>

                    <!-- Payroll Information Widget -->
                    <div class="bg-white p-5 rounded-lg shadow-lg widget">
                        <div>
                            <h3 class="text-lg font-bold">Payroll</h3>
                            <p>Last Payment: <%= lastPayment %></p>
                            <p>Next Payment Date: <%= nextPaymentDate %></p>
                        </div>
                        <a href="/employee-dashboard/payroll">
                            <button class="bg-indigo-600 text-white px-4 py-2 rounded-lg mt-auto">
                                View Payroll
                            </button>
                        </a>
                    </div>

                    <!-- Leave Requests Widget -->
                    <div class="bg-white p-5 rounded-lg shadow-lg widget">
                        <div>
                            <h3 class="text-lg font-bold">Leave Requests</h3>
                            <p>Pending Requests: <%= leaveRequestsCount %></p>
                        </div>
                        <a href="/employee-dashboard/leaveRequest">
                            <button class="bg-indigo-600 text-white px-4 py-2 rounded-lg mt-auto">
                                Request Leave
                            </button>
                        </a>
                    </div>

                    <!-- Performance Widget -->
                    <div class="bg-white p-5 rounded-lg shadow-lg widget">
                        <div>
                            <h3 class="text-lg font-bold">Performance Review</h3>
                            <p>Last Review: <%= lastReviewDate %></p>
                            <p>Next Review: <%= nextReviewDate %></p>
                        </div>
                        <a href="/employee-dashboard/performance">
                            <button class="bg-indigo-600 text-white px-4 py-2 rounded-lg mt-auto">
                                View Review
                            </button>
                        </a>
                    </div>

                    <!-- Training Sessions Widget -->
                    <div class="bg-white p-5 rounded-lg shadow-lg widget">
                        <div>
                            <h3 class="text-lg font-bold">Training Sessions</h3>
                            <p>Stay tuned for upcoming sessions!</p>
                        </div>
                        <a href="/employee-dashboard/trainingSession">
                            <button class="bg-indigo-600 text-white px-4 py-2 rounded-lg mt-auto">
                                View Training
                            </button>
                        </a>
                    </div>
                </section>

                <!-- To-Do List for Employee Tasks -->
                <div class="bg-white p-5 rounded-lg shadow-lg space-y-4">
                    <div class="flex justify-between items-center">
                        <h3 class="text-lg font-bold">To-Do List</h3>
                        <button id="addTaskBtn" class="bg-green-500 text-white px-4 py-2 rounded">+ Add Task</button>
                    </div>
                    <ul id="taskList" class="space-y-2">
                        <% tasks.forEach(task => { %>
                        <li class="task-item flex justify-between items-center p-2 bg-gray-100 rounded-lg hover:bg-blue-100" data-id="<%= task.taskId %>">
                            <span class="<%= task.status ? 'line-through text-gray-500' : '' %>">
                                <%= task.title %>
                            </span>
                            <div class="flex space-x-2">
                                <button class="mark-as-done <%= task.status ? 'active bg-green-500' : 'bg-indigo-600' %> text-white px-3 py-1 rounded" onclick="toggleTaskStatus(<%= task.taskId %>, this)">
                                    <%= task.status ? 'Done' : 'Mark as Done' %>
                                </button>
                                <button class="delete-task bg-red-600 text-white px-3 py-1 rounded" onclick="deleteTask(<%= task.taskId %>, this)">Delete</button>
                            </div>
                        </li>
                        <% }) %>
                    </ul>
                </div>
            </main>

            <!-- Rightbar -->
            <%- include('employee/right-bar') %>
    </div>

    <script>
        async function toggleTaskStatus(taskId, button) {
            try {
                const response = await fetch(`/api/tasks/${taskId}`, { method: 'PATCH' });
                if (response.ok) {
                    const task = await response.json();
                    button.classList.toggle('active');
                    button.classList.toggle('bg-green-500');
                    button.classList.toggle('bg-indigo-600');
                    button.textContent = task.status ? 'Done' : 'Mark as Done';
                    
                    const span = button.closest('.task-item').querySelector('span');
                    span.classList.toggle('line-through');
                    span.classList.toggle('text-gray-500');
                }
            } catch (err) {
                console.error('Error toggling task:', err);
            }
        }

        async function deleteTask(taskId, button) {
            if (!confirm('Are you sure you want to delete this task?')) return;
            try {
                const response = await fetch(`/api/tasks/${taskId}`, { method: 'DELETE' });
                if (response.ok) {
                    button.closest('.task-item').remove();
                }
            } catch (err) {
                console.error('Error deleting task:', err);
            }
        }

        document.getElementById('addTaskBtn').addEventListener('click', async function () {
            const title = prompt('Enter new task:');
            if (title) {
                try {
                    const response = await fetch('/api/tasks', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ title })
                    });
                    if (response.ok) {
                        location.reload(); // Simplest way to refresh the list and counts
                    }
                } catch (err) {
                    console.error('Error adding task:', err);
                }
            }
        });
    </script>
</body>

</html>
